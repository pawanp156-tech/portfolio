# Served by Hostinger (LiteSpeed/Apache). Vite copies everything in public/
# straight into dist/, so this lands next to index.html on the server.

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------- Caching ----------
<IfModule mod_expires.c>
  ExpiresActive On

  # Build output is content-hashed (index-BnvNVA9l.js), so a changed file always
  # has a new name. Safe to cache for a year.
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(svg|ico|png|jpg|jpeg|webp|avif)$">
    ExpiresDefault "access plus 6 months"
  </FilesMatch>

  # index.html must NOT be cached long — it is what points at the new hashed
  # filenames after a deploy. Cache it and visitors keep loading the old build.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------- Security headers ----------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ---------- HTTPS ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------- Errors ----------
# The site is a single page with hash links, so there are no client-side routes
# to rewrite. Anything genuinely missing falls back to the homepage.
ErrorDocument 404 /index.html
